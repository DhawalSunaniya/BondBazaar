# ─────────────────────────────────────────────────────────────────────────────
# BondBazaar — Environment Configuration Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values:
#   python scripts/setup_env.py      ← recommended (interactive helper)
#   cp .env.example .env             ← manual copy
#
# ⚠️  Render does NOT read .env files. Set all variables directly in:
#      Render → Your Service → Environment
# ─────────────────────────────────────────────────────────────────────────────


# ── Platform ──────────────────────────────────────────────────────────────────
PLATFORM_NAME=BondBazaar

# deployment environment: "development" (default) or "production"
# In production, the app refuses to start if any secret is missing/insecure.
ENVIRONMENT=development


# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (local dev):
DATABASE_URL=sqlite:///./bondbazaar.db
# PostgreSQL (Render / prod) — "postgres://" is auto-converted to "postgresql://":
# DATABASE_URL=postgresql://user:password@host:5432/bondbazaar


# ── Session / Auth secrets ────────────────────────────────────────────────────
# Required in production. Auto-generated on each restart in development.
SECRET_KEY=replace-with-secrets-token-urlsafe-32
SESSION_SECRET=replace-with-secrets-token-urlsafe-32
ACCESS_TOKEN_EXPIRY_DAYS=90
ADMIN_PASSWORD=replace-with-strong-admin-password


# ── Webhook ───────────────────────────────────────────────────────────────────
# Required in production. Auto-generated in development.
WEBHOOK_SIGNING_SECRET=replace-with-secrets-token-urlsafe-32


# ── Demo / Sandbox ────────────────────────────────────────────────────────────
DEMO_OTP=123456
BASE_URL=http://localhost:8000
CORS_ORIGINS=*

# Override the demo API client secret (defaults to "bb-demo-secret" in dev):
# DEMO_API_CLIENT_SECRET=replace-with-strong-secret


# ── Google OAuth (optional) ───────────────────────────────────────────────────
# Leave blank to disable Google login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=


# ── Allow-lists (comma-separated) ────────────────────────────────────────────
ALLOWED_REDIRECT_URIS=http://localhost:3000/link-complete,https://oauth.pstmn.io/v1/callback,http://127.0.0.1:3000/link-complete
ALLOWED_WEBHOOK_URLS=http://localhost:8000/webhooks/bondbazaar,http://127.0.0.1:8000/webhooks/bondbazaar,https://webhook.site/demo
# Optional: restrict login to these emails only. Empty = all emails allowed.
ALLOWED_EMAILS=


# ── TradeOne / Broker identity ────────────────────────────────────────────────
BROKER_NAME=BondBazaar
PROVIDER_CODE=c
DP_NAME=BondBazaar Depository Services
DP_ID=IN300003
# Optional external depository URL:
DEPOSITORY_URL=


# ── TradeOne Internal API ─────────────────────────────────────────────────────
# ⚠️  MUST BE IDENTICAL ON ALL FOUR SIBLING SITES (BondBazaar, NiftyTrade,
#     BharatInvest, and TradeOne itself). Never auto-generated.
#     Run scripts/setup_env.py and enter the same values on every site.
INTERNAL_API_ENABLED=true
INTERNAL_API_KEY=tradeone-internal-secret-key
SHARED_IDENTITY_SALT=tradeone-shared-identity-salt
# TradeOne aggregator outbox destination URL:
TRADEONE_URL=


# ── Portfolio seeding ─────────────────────────────────────────────────────────
STARTING_FUNDS=1000000
SEED_STARTER_PORTFOLIO=false
